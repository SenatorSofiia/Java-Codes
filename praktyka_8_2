			g.drawLine(150, 150, 150, 200);
			g.drawLine(150, 200, 125, 250);
			g.drawLine(125, 250, 100, 200);
			g.drawLine(100, 200, 150, 200);
			g.drawLine(100, 200, 100, 150);
			g.drawOval(115, 165, 20, 20);
			
		}
		public static void main(String[] args) {
			new prakt_8_2();
		}}
