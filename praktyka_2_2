package prakt_2;
import  java.util.Scanner;
class Reader {
   int a, b, c, d;
   public void Scan() {
       Scanner scn = new Scanner(System.in);
       System.out.println("Введіть число a");
       a = scn.nextInt();
       System.out.println("Введіть число b");
       b = scn.nextInt();
       System.out.println("Введіть число c");
       c = scn.nextInt();
       System.out.println("Введіть число d");
       d = scn.nextInt();
   }
}


package prakt_2;
public class prakt_2_1 {
	class Lab3 {
	    public static void main(String args[]) {
	        int y, z;
	        Reader myR = new Reader();
	        myR.Scan();
	        y = myR.a + myR.b - myR.c * myR.d;
	        switch (y) {
	            case 1:
	                z = (2 + myR.a);
	                System.out.println("z=" + z);
	                break;
	            case 2:
	                z = (7 * myR.b);
	                System.out.println("z=" + z);
	                break;
	            case 6:
	                z = (8 - myR.c);
	                System.out.println("z=" + z);
	                break;
	            case 10:
	                z = (10*myR.d);
	                System.out.println("z=" + z);
	                break;
	            default:
	                System.out.println("default");
	        }
	    }
	}
}
