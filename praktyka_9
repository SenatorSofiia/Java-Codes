package prakt_9;
import java.util.ArrayList;
import java.util.List;
public class prakt_9_1 {
	class Main{
		public static void main(String[] args) {
			List<Camera>camera=new ArrayList<>();
			camera.add(new Camera(1, "Canon", "Black", 3));
			camera.add(new Camera(2, "Sony", "Gray", 27));
			camera.add(new Camera(3, "Samsung", "White", 80));
			for(int i=0; i<camera.size(); i++) {
				if(camera.get(i).mpx<12) {
					camera.get(i).color = "Red";
				}
				System.out.println(camera.get(i));
			}
		}
		static class Camera {
			int id;
			String model;
			String color;
			int mpx;
			
			@Override
			public String toString() {
			return "Camera{" +
			"id=" + id +
			", model='" + model + '\'' +
			", color='" + color + '\'' +
			", mpx=" + mpx +
			'}';
			}
			public Camera(int id, String model, String color, int mpx) {
			this.id = id;
			this.model = model;
			this.color = color;
			this.mpx = mpx;
			}
		}
	}
}
