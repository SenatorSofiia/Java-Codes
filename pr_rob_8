package pr_8;
public class pr_8_1 {
   public static void main(String[] args) {
       int[][] a = {
           {10, 76, 39},
           {3, 95, 13},
           {94, 46, 22}
       };
       int[] temp = new int[9];
       int index = 0;
       for (int i = 0; i < 3; i++) {
           for (int j = 0; j < 3; j++) {
               temp[index++] = a[i][j];
           }
       }
       for (int i = temp.length - 1; i >= 1; i--) {
           boolean sorted = true;
           for (int j = 0; j < i; j++) {
               if (temp[j] > temp[j + 1]) {
                   int t = temp[j];
                   temp[j] = temp[j + 1];
                   temp[j + 1] = t;
                   sorted = false;
               }
           }
           if (sorted) break;
       }
       index = 0;
       for (int i = 0; i < 3; i++) {
           for (int j = 0; j < 3; j++) {
               a[i][j] = temp[index++];
           }
       }
       System.out.println("Відсортований масив:");
       for (int i = 0; i < 3; i++) {
           for (int j = 0; j < 3; j++) {
               System.out.print(a[i][j] + "\t");
           }
           System.out.println();
       }
   }
}
