		c=countC(a,b);
		y=countY(c);
		System.out.println(y);
		}
	private static double countA(double x, double b){
	double a = sqrt(abs(x))+pow(Math.E, sqrt(b));
	return a;
		}
	private static double countC(double a, double b){
		double c = pow(a,2)+pow(b,2);
		return c;
	}
	private static double countY(double c){
		double y = pow(c,3)/cos(c);
		return y;
	}
}
